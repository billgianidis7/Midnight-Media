rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isValidReleaseType(val) {
      return val is string && val in ['Album', 'Single', 'EP', 'Remix'];
    }

    function isValidVisibility(val) {
      return val is string && val in ['public', 'private'];
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidTags(tags) {
      return tags is list && tags.size() <= 5 && (tags.size() == 0 || (tags[0] is string && tags[0].size() <= 32));
    }

    function isValidPeaks(peaks) {
      return peaks is list && peaks.size() <= 128 && (peaks.size() == 0 || (peaks[0] is number && peaks[0] >= 0 && peaks[0] <= 100));
    }

    function currentTrackLikes(trackData) {
      return ('likeCount' in trackData && trackData.likeCount is int) ? trackData.likeCount : 0;
    }

    // --- Entity Validation Blueprints ---
    function isValidAlbum(data, albumId) {
      return data.keys().hasAll([
          'id', 'title', 'artist', 'releaseType', 'year', 'commentary',
          'coverUrl', 'tags', 'visibility', 'authorUid', 'authorName',
          'trackCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'artist', 'releaseType', 'year', 'commentary',
          'coverUrl', 'tags', 'visibility', 'authorUid', 'authorName',
          'trackCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == albumId
        && isValidString(data.title, 1, 120)
        && isValidString(data.artist, 1, 80)
        && isValidReleaseType(data.releaseType)
        && isValidString(data.year, 4, 4)
        && data.year.matches('^\\d{4}$')
        && isValidString(data.commentary, 0, 2000)
        && isValidString(data.coverUrl, 0, 500)
        && isValidTags(data.tags)
        && isValidVisibility(data.visibility)
        && isValidId(data.authorUid)
        && data.authorUid == request.auth.uid
        && isValidString(data.authorName, 1, 80)
        && data.trackCount is int
        && data.trackCount >= 0
        && data.trackCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrack(data, trackId) {
      return data.keys().hasAll([
          'id', 'albumId', 'albumTitle', 'title', 'artist', 'releaseType', 'year',
          'commentary', 'coverUrl', 'durationSec', 'snippetStartSec', 'snippetEndSec',
          'waveformPeaks', 'audioSourceType', 'synthPreset', 'localFileId',
          'driveFileId', 'driveWebViewLink', 'visibility', 'authorUid',
          'authorName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'albumId', 'albumTitle', 'title', 'artist', 'releaseType', 'year',
          'commentary', 'coverUrl', 'durationSec', 'snippetStartSec', 'snippetEndSec',
          'waveformPeaks', 'audioSourceType', 'synthPreset', 'localFileId',
          'driveFileId', 'driveWebViewLink', 'likeCount', 'visibility', 'authorUid',
          'authorName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == trackId
        && isValidId(data.albumId)
        && isValidString(data.albumTitle, 1, 120)
        && isValidString(data.title, 1, 120)
        && isValidString(data.artist, 1, 80)
        && isValidReleaseType(data.releaseType)
        && isValidString(data.year, 4, 4)
        && data.year.matches('^\\d{4}$')
        && isValidString(data.commentary, 0, 2000)
        && isValidString(data.coverUrl, 0, 500)
        && data.durationSec is number
        && data.durationSec > 0
        && data.durationSec <= 3600
        && data.snippetStartSec is number
        && data.snippetStartSec >= 0
        && data.snippetEndSec is number
        && data.snippetEndSec >= data.snippetStartSec
        && data.snippetEndSec <= data.durationSec + 1
        && isValidPeaks(data.waveformPeaks)
        && data.audioSourceType is string
        && data.audioSourceType in ['synth', 'local_idb', 'drive']
        && isValidString(data.synthPreset, 0, 64)
        && isValidString(data.localFileId, 0, 128)
        && isValidString(data.driveFileId, 0, 256)
        && isValidString(data.driveWebViewLink, 0, 512)
        && (!('likeCount' in data) || (data.likeCount is int && data.likeCount >= 0 && data.likeCount <= 10000000))
        && isValidVisibility(data.visibility)
        && isValidId(data.authorUid)
        && isValidString(data.authorName, 1, 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackLike(data, trackId, userId) {
      return data.keys().hasAll(['trackId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['trackId', 'userId', 'createdAt'])
        && isValidId(data.trackId)
        && data.trackId == trackId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidAlbumComment(data, albumId, commentId) {
      return data.keys().hasAll(['id', 'albumId', 'body', 'visibility', 'authorUid', 'authorName', 'authorPhotoUrl', 'createdAt'])
        && data.keys().hasOnly(['id', 'albumId', 'body', 'visibility', 'authorUid', 'authorName', 'authorPhotoUrl', 'createdAt'])
        && isValidId(data.id)
        && data.id == commentId
        && isValidId(data.albumId)
        && data.albumId == albumId
        && isValidString(data.body, 1, 1000)
        && data.visibility == 'public'
        && isValidId(data.authorUid)
        && data.authorUid == request.auth.uid
        && isValidString(data.authorName, 1, 80)
        && isValidString(data.authorPhotoUrl, 0, 500)
        && data.createdAt is timestamp;
    }

    function isValidTrackComment(data, trackId, commentId) {
      return data.keys().hasAll(['id', 'trackId', 'timestampLabel', 'body', 'visibility', 'authorUid', 'authorName', 'authorPhotoUrl', 'createdAt'])
        && data.keys().hasOnly(['id', 'trackId', 'timestampLabel', 'body', 'visibility', 'authorUid', 'authorName', 'authorPhotoUrl', 'createdAt'])
        && isValidId(data.id)
        && data.id == commentId
        && isValidId(data.trackId)
        && data.trackId == trackId
        && isValidString(data.timestampLabel, 0, 16)
        && isValidString(data.body, 1, 1000)
        && data.visibility == 'public'
        && isValidId(data.authorUid)
        && data.authorUid == request.auth.uid
        && isValidString(data.authorName, 1, 80)
        && isValidString(data.authorPhotoUrl, 0, 500)
        && data.createdAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'driveFolderId', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'driveFolderId', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && isValidString(data.email, 3, 254)
        && isValidString(data.driveFolderId, 0, 256)
        && data.updatedAt is timestamp;
    }

    function isValidBackupRecord(data, userId, backupId) {
      return data.keys().hasAll(['id', 'ownerUid', 'trackId', 'albumId', 'fileName', 'mimeType', 'sizeBytes', 'kind', 'driveFileId', 'driveWebViewLink', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'trackId', 'albumId', 'fileName', 'mimeType', 'sizeBytes', 'kind', 'driveFileId', 'driveWebViewLink', 'createdAt'])
        && isValidId(data.id)
        && data.id == backupId
        && isValidId(data.ownerUid)
        && data.ownerUid == userId
        && isValidString(data.trackId, 0, 128)
        && isValidString(data.albumId, 0, 128)
        && isValidString(data.fileName, 1, 200)
        && isValidString(data.mimeType, 1, 100)
        && data.sizeBytes is number
        && data.sizeBytes >= 0
        && data.kind is string
        && data.kind in ['audio_master', 'reel_snippet', 'reel_video', 'album_archive']
        && isValidString(data.driveFileId, 1, 256)
        && isValidString(data.driveWebViewLink, 0, 512)
        && data.createdAt is timestamp;
    }

    // --- Albums Collection ---
    match /albums/{albumId} {
      allow get: if isValidId(albumId) && (
        existing().visibility == 'public' || (isSignedIn() && existing().authorUid == request.auth.uid)
      );
      allow list: if resource.data.visibility == 'public' || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(albumId)
        && isValidAlbum(incoming(), albumId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(albumId)
        && isValidAlbum(incoming(), albumId)
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'artist', 'releaseType', 'year', 'commentary', 'coverUrl', 'tags', 'visibility', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['trackCount', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(albumId)
        && existing().authorUid == request.auth.uid;

      // Album Comments Subcollection (Master Gate)
      match /comments/{commentId} {
        allow get: if isValidId(albumId) && isValidId(commentId) && (
          get(/databases/$(database)/documents/albums/$(albumId)).data.visibility == 'public'
          || (isSignedIn() && get(/databases/$(database)/documents/albums/$(albumId)).data.authorUid == request.auth.uid)
        );
        allow list: if resource.data.visibility == 'public' || (isSignedIn() && resource.data.authorUid == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(albumId)
          && isValidId(commentId)
          && isValidAlbumComment(incoming(), albumId, commentId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/albums/$(albumId))
          && (
            get(/databases/$(database)/documents/albums/$(albumId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/albums/$(albumId)).data.authorUid == request.auth.uid
          );

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(albumId)
          && isValidId(commentId)
          && (
            existing().authorUid == request.auth.uid
            || get(/databases/$(database)/documents/albums/$(albumId)).data.authorUid == request.auth.uid
          );
      }
    }

    // --- Tracks Feed Collection ---
    match /tracks/{trackId} {
      allow get: if isValidId(trackId) && (
        existing().visibility == 'public' || (isSignedIn() && existing().authorUid == request.auth.uid)
      );
      allow list: if resource.data.visibility == 'public' || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(trackId)
        && isValidTrack(incoming(), trackId)
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/albums/$(incoming().albumId))
        && get(/databases/$(database)/documents/albums/$(incoming().albumId)).data.authorUid == request.auth.uid;

      allow update: if isVerifiedUser()
        && isValidId(trackId)
        && isValidTrack(incoming(), trackId)
        && incoming().authorUid == existing().authorUid
        && incoming().id == existing().id
        && incoming().albumId == existing().albumId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Track owner edits or Drive/Snippet sync
          (
            existing().authorUid == request.auth.uid
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'albumTitle', 'artist', 'releaseType', 'year', 'commentary', 'coverUrl', 'visibility', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['snippetStartSec', 'snippetEndSec', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['driveFileId', 'driveWebViewLink', 'updatedAt'])
            )
          )
          ||
          // Tier 2: Verified listener atomic Like / Unlike sync
          (
            (existing().visibility == 'public' || existing().authorUid == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['likeCount', 'updatedAt'])
            && incoming().likeCount is int
            && (
              (
                incoming().likeCount == currentTrackLikes(existing()) + 1
                && !exists(/databases/$(database)/documents/tracks/$(trackId)/likes/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/tracks/$(trackId)/likes/$(request.auth.uid))
              )
              || (
                incoming().likeCount == currentTrackLikes(existing()) - 1
                && incoming().likeCount >= 0
                && exists(/databases/$(database)/documents/tracks/$(trackId)/likes/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/tracks/$(trackId)/likes/$(request.auth.uid))
              )
            )
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(trackId)
        && existing().authorUid == request.auth.uid;

      // Track Likes Subcollection (Atomic sync with parent Track likeCount)
      match /likes/{userId} {
        allow get: if isValidId(trackId) && isValidId(userId) && isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(trackId)
          && isValidId(userId)
          && userId == request.auth.uid
          && isValidTrackLike(incoming(), trackId, userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/tracks/$(trackId))
          && (
            get(/databases/$(database)/documents/tracks/$(trackId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/tracks/$(trackId)).data.authorUid == request.auth.uid
          )
          && getAfter(/databases/$(database)/documents/tracks/$(trackId)).data.likeCount
             == currentTrackLikes(get(/databases/$(database)/documents/tracks/$(trackId)).data) + 1;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(trackId)
          && isValidId(userId)
          && userId == request.auth.uid
          && existing().userId == request.auth.uid
          && exists(/databases/$(database)/documents/tracks/$(trackId))
          && getAfter(/databases/$(database)/documents/tracks/$(trackId)).data.likeCount
             == currentTrackLikes(get(/databases/$(database)/documents/tracks/$(trackId)).data) - 1;
      }

      // Track Comments Subcollection (Master Gate)
      match /comments/{commentId} {
        allow get: if isValidId(trackId) && isValidId(commentId) && (
          get(/databases/$(database)/documents/tracks/$(trackId)).data.visibility == 'public'
          || (isSignedIn() && get(/databases/$(database)/documents/tracks/$(trackId)).data.authorUid == request.auth.uid)
        );
        allow list: if resource.data.visibility == 'public' || (isSignedIn() && resource.data.authorUid == request.auth.uid);

        allow create: if isVerifiedUser()
          && isValidId(trackId)
          && isValidId(commentId)
          && isValidTrackComment(incoming(), trackId, commentId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/tracks/$(trackId))
          && (
            get(/databases/$(database)/documents/tracks/$(trackId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/tracks/$(trackId)).data.authorUid == request.auth.uid
          );

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(trackId)
          && isValidId(commentId)
          && (
            existing().authorUid == request.auth.uid
            || get(/databases/$(database)/documents/tracks/$(trackId)).data.authorUid == request.auth.uid
          );
      }
    }

    // --- Isolated User Private Info & Cloud Backups ---
    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && docId == 'profile';
      allow list: if false;
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && docId == 'profile'
        && isValidUserPrivate(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId) && docId == 'profile';
    }

    match /users/{userId}/backups/{backupId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(backupId) && existing().ownerUid == request.auth.uid;
      allow list: if isSignedIn() && request.auth.uid == userId && resource.data.ownerUid == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidId(backupId)
        && isValidBackupRecord(incoming(), userId, backupId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(backupId) && existing().ownerUid == request.auth.uid;
    }
  }
}
